import { create } from "zustand";
import { randomUUID } from "node:crypto";
// 与 db.ts 一致:用 node:crypto.randomUUID 替代 uuid 包,少一个依赖
const uuidv4 = randomUUID;

/* ── Types ─────────────────────────────────────────────── */

export interface ToolEvent {
  label: string;
  detail?: string;
  status?: "running" | "done";
}

export interface ChatMessage {
  id: string;
  role: "user" | "assistant" | "system";
  content: string;
  timestamp: number;
  imageUrls?: string[];
  /** 本轮的工具调用记录(前端折叠展示) */
  toolEvents?: ToolEvent[];
  /** 工具调用摘要,随历史回传给模型(避免重复搜索) */
  toolNote?: string;
}

export interface Conversation {
  id: string;
  title: string;
  messages: ChatMessage[];
  createdAt: number;
  updatedAt: number;
  modelId?: string; // 对话使用的模型（可选，覆盖全局设置）
  systemPrompt?: string; // 每对话系统提示词/人设
}

export type ImageProvider = "flux" | "dall-e" | "gemini" | "kling" | "tongyi";

export interface Settings {
  apiProvider: ImageProvider;
  /** 图片生成:每个提供商各自的 key(切换提供商自动带各自的 key) */
  apiKeys: Partial<Record<ImageProvider, string>>;
  chatApiUrl: string;  // 对话 API 地址（云端模型）
  /** 对话 API:按提供商域名各存一个 key */
  chatProviderKeys: Record<string, string>;
  chatModel: string;   // 对话模型名称(可自选任意 ID)
  imageModel: string;  // 图片生成模型
  enableTools: boolean; // 启用 AI 工具调用（搜索/爬取）
  /** 工具调用链路设置 */
  toolMaxRounds: number;   // 工具循环最大轮数(1-10,防无限循环)
  enabledTools: string[]; // 启用的工具白名单(按名称过滤)
  toolAutoRead: boolean;   // web_search 后自动阅读前 2 条结果全文
  toolParallel: boolean;   // 同一轮的多个工具调用并行执行
  /** GitHub 工具:可选个人访问令牌(公共数据无需登录,配置后 API 限额 60→5000 次/小时) */
  githubToken: string;
  /** SVSG V5.2.1 结构化视觉语义网关:服务地址(本地/内网服务,默认 127.0.0.1:3002) */
  svsgApiUrl: string;
  /** SVSG 网关访问令牌(服务端 SVSG_API_KEY 未设置时留空) */
  svsgApiKey: string;
  /** 编程模式:开启后系统提示词/上下文裁剪/工具行为都按编程场景优化(省 token) */
  codeMode: boolean;
  /** 编程模式子模式:"auto" 自动化编程(直接产出代码) / "collab" 人机协作编程(对话旁工作区迭代) */
  codeModeType: "auto" | "collab";
  /** 编程模式下的目标语言(用于给模型发「用 X 语言回答」信号) */
  codeLanguage: string;
  /** 审核模式:编程结果用独立 API key 的模型做审核(手动触发) */
  codeReviewEnabled: boolean;
  /** 审核用 API 地址(默认复用 chatApiUrl) */
  codeReviewApiUrl: string;
  /** 审核用独立 API key */
  codeReviewApiKey: string;
  /** 审核用模型(默认复用 chatModel) */
  codeReviewModel: string;
  /** Agent 集群:编程模式下多路 Agent 并行产出方案,最高 4 路 */
  agentClusterEnabled: boolean;
  /** 集群路数 1-4 */
  agentClusterCount: number;
  /** 每路的 API 地址(可相同,可复用默认) */
  agentClusterApiUrls: string[];
  /** 每路的 API key(可填相同 key) */
  agentClusterKeys: string[];
  /** 每路的模型(可复用默认) */
  agentClusterModels: string[];
  maxContextTurns: number; // 滑动窗口大小
  tokenBudget: number;    // 每次请求的 max_tokens
  modelName: string;
  /** 对话温度(聊天模式,默认 0.7;编程模式下由 codeTemperature 覆盖) */
  temperature: number;
  /** 编程模式温度(默认 0.3,代码输出更确定、更省 token) */
  codeTemperature: number;
  /** 子 Agent 分工模式:用户自定义的预设 subAgents(在请求前自动附带) */
  subAgentPresets: SubAgentPreset[];
  /** 是否默认启用子 Agent 分工模式(为 true 且 subAgentPresets 非空时,每次请求自动带上预设) */
  subAgentEnabled: boolean;
}

/** 用户预设的子 Agent(在设置面板里编辑,发请求时随主请求一起发出)
 *  - role: 简短角色名,如 researcher / summarizer
 *  - systemPrompt: 该子 Agent 的 system 提示词
 *  - modelName: 可选,留空使用主对话模型;想用降级模型就填便宜小模型
 */
export interface SubAgentPreset {
  id: string;
  role: string;
  systemPrompt: string;
  modelName?: string;
}

export interface ChatState {
  // Conversations
  conversations: Conversation[];
  currentConversationId: string | null;
  loaded: boolean; // 服务端历史是否已加载完成

  // Settings
  settings: Settings;

  /** 流式期间独立的最后一条消息引用(订阅此字段的组件随 token re-render,但不会触发整列表重渲染) */
  streamingSlice: { conversationId: string; message: ChatMessage } | null;

  // UI State
  sidebarOpen: boolean;
  settingsOpen: boolean;
  imageGenOpen: boolean;
  isGenerating: boolean;

  // Actions
  _init: () => Promise<void>;
  persistConversation: (id: string) => void;

  createConversation: () => string;
  deleteConversation: (id: string) => void;
  setCurrentConversation: (id: string) => void;
  updateConversationTitle: (id: string, title: string) => void;
  updateConversationSystemPrompt: (id: string, systemPrompt: string) => void;

  addMessage: (conversationId: string, message: Omit<ChatMessage, "id" | "timestamp">) => void;
  beginStream: (conversationId: string) => void;
  appendStreamToken: (conversationId: string, token: string) => void;
  endStream: () => void;
  updateLastAssistantMessage: (
    conversationId: string,
    content?: string,
    extras?: {
      appendToolEvent?: ToolEvent;
      finishToolEvent?: { label: string; detail?: string };
      setToolNote?: string;
    }
  ) => void;
  /** 往当前正在流式回复的助手消息追加一段文本(高频调用,只重建最后一条消息)
   * - 内部直读 conversations,跳过中间层,避免每次 setState 序列化整个对话数组
   * - 通过写入单独的 streamingSlice 引用,订阅者只在 slice 变化时 re-render
   */

  /** 结束流式时清空 streamingSlice,正常进入持久化流程 */

  updateMessage: (conversationId: string, messageId: string, content: string) => void;
  truncateMessagesAfter: (conversationId: string, messageId: string) => void;

  updateSettings: (settings: Partial<Settings>) => void;
  setSidebarOpen: (open: boolean) => void;
  setSettingsOpen: (open: boolean) => void;
  setImageGenOpen: (open: boolean) => void;
  setIsGenerating: (generating: boolean) => void;

  // Computed
  getCurrentConversation: () => Conversation | undefined;
  getDisplayMessages: () => ChatMessage[];
}

/* ── Defaults ──────────────────────────────────────────── */

