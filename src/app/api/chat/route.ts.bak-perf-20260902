import { NextRequest } from "next/server";
import { chatCompletionStream, ChatMessage } from "@/lib/hr-client";
import {
  cloudChatStream,
  validateChatApiUrl,
  chatApiGuard,
  clampMaxTokens,
} from "@/lib/cloud-chat";
import { guardedFetch } from "@/lib/url-guard";
import {
  getEnabledTools,
  executeTool,
  toolsToOpenAIFunctions,
  parseToolCalls,
